# Copy this file to .env and fill in the values
# SMTP settings for nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password

# The email that should receive contact form messages
TO_EMAIL=anupchopde06@gmail.com

# Optional: the From header used in sent emails
SMTP_FROM="My Portfolio" <your-smtp-username@example.com>

# If your frontend runs on a different host/port, set this to that host (e.g. http://localhost:5173)
# VITE_API_URL=http://localhost:5000
